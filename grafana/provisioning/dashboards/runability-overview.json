    {
      "id": 16,
      "type": "text",
      "title": "Manual Update",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 0 },
      "options": {
        "mode": "html",
        "content": "<form id=\"collect-form\" action=\"http://localhost:8000/collect\" method=\"post\" target=\"collect-frame\"><button id=\"collect-now\" type=\"submit\" style=\"width:100%;height:64px;border:0;border-radius:6px;background:#2563eb;color:white;font-size:22px;font-weight:700;cursor:pointer;\">Update now</button></form><iframe name=\"collect-frame\" style=\"display:none;\"></iframe><div id=\"collect-status\" style=\"margin-top:10px;text-align:center;font-size:14px;\">Ready</div><script>\n(function () {\n  const form = document.getElementById('collect-form');\n  const button = document.getElementById('collect-now');\n  const status = document.getElementById('collect-status');\n  if (!form || !button || !status) return;\n  function selectedLocationId() {\n    const params = new URLSearchParams(window.location.search);\n    return params.get('var-location_id') || 'bme_campus';\n  }\n  form.onsubmit = async function (event) {\n    event.preventDefault();\n    button.disabled = true;\n    button.style.opacity = '0.65';\n    status.textContent = 'Collecting...';\n    try {\n      const locationId = encodeURIComponent(selectedLocationId());\n      const response = await fetch('http://localhost:8000/collect?location_id=' + locationId, { method: 'POST' });\n      const payload = await response.json();\n      if (!response.ok || !payload.ok) throw new Error(payload.error || 'Request failed');\n      status.textContent = 'Updated. Refreshing dashboard...';\n      setTimeout(function () { window.location.reload(); }, 800);\n    } catch (error) {\n      status.textContent = 'Failed: ' + error.message;\n      button.disabled = false;\n      button.style.opacity = '1';\n    }\n  };\n})();\n</script>"
      }
    },
    {
      "id": 17,
      "type": "geomap",
      "title": "Smart City Runability Map",
      "datasource": { "type": "influxdb", "uid": "RunabilityInflux" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"runability\") |> range(start: -7d) |> filter(fn: (r) => r._measurement == \"runability_score\") |> filter(fn: (r) => contains(value: r.location_id, set: [\"bme_campus\", \"budapest_downtown\", \"margaret_island\", \"kopaszi_gat\", \"obuda\"])) |> filter(fn: (r) => contains(value: r._field, set: [\"score\", \"latitude\", \"longitude\"])) |> group(columns: [\"location_id\", \"location_name\", \"_field\"]) |> last() |> group() |> pivot(rowKey: [\"location_id\", \"location_name\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> filter(fn: (r) => exists r.latitude and exists r.longitude and exists r.score) |> keep(columns: [\"location_id\", \"location_name\", \"latitude\", \"longitude\", \"score\"])"
        }
      ],
      "options": {
        "view": { "id": "coords", "lat": 47.4979, "lon": 19.0500, "zoom": 12 },
        "controls": {
          "showZoom": true,
          "showAttribution": true,
          "showScale": true,
          "showMeasure": false,
          "showDebug": false
        },
        "tooltip": { "mode": "details" },
        "layers": [
          {
            "type": "markers",
            "name": "Runability locations",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": { "fixed": 14, "min": 8, "max": 22 },
                "color": { "field": "score", "fixed": "green" }
              }
            }
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "green", "value": 70 }
            ]
          },
          "links": [
            {
              "title": "Open this location",
              "url": "/d/runability-overview/runability-homework-dashboard?orgId=1&var-location_id=${__data.fields.location_id}",
              "targetBlank": false
            }
          ],
          "custom": {}
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Temperature: Measured + Forecast",
      "datasource": { "type": "influxdb", "uid": "RunabilityInflux" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "query": "measured = from(bucket: \"runability\") |> range(start: v.timeRangeStart, stop: now()) |> filter(fn: (r) => r.location_id == \"${location_id}\") |> filter(fn: (r) => r._measurement == \"weather_raw\" and r._field == \"temperature_c\") |> keep(columns: [\"_time\", \"_value\"]) |> set(key: \"_field\", value: \"Temperature\")\nforecast = from(bucket: \"runability\") |> range(start: now(), stop: v.timeRangeStop) |> filter(fn: (r) => r.location_id == \"${location_id}\") |> filter(fn: (r) => r._measurement == \"weather_forecast_hourly\" and r._field == \"temperature_c\") |> keep(columns: [\"_time\", \"_value\"]) |> set(key: \"_field\", value: \"Temperature\")\nunion(tables: [measured, forecast]) |> group(columns: [\"_field\"]) |> sort(columns: [\"_time\"])"
        },
        {
          "refId": "B",
          "query": "from(bucket: \"runability\") |> range(start: v.timeRangeStart, stop: now()) |> filter(fn: (r) => r.location_id == \"${location_id}\") |> filter(fn: (r) => r._measurement == \"weather_raw\" and r._field == \"temperature_c\") |> last() |> map(fn: (r) => ({ r with _time: now(), _field: \"Current time\" }))"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Current time" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.drawStyle", "value": "points" },
              { "id": "custom.pointSize", "value": 10 },
              { "id": "custom.showPoints", "value": "always" },
              { "id": "custom.lineWidth", "value": 0 },
              { "id": "custom.hideFrom", "value": { "tooltip": false, "viz": false, "legend": true } }
            ]
          }
        ]
      }
    },
