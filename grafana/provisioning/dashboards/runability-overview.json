    },
    {
      "id": 13,
      "type": "stat",
      "title": "Current Wind (km/h)",
      "datasource": { "type": "influxdb", "uid": "RunabilityInflux" },
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"runability\") |> range(start: -7d) |> filter(fn: (r) => r.location_id == \"${location_id}\") |> filter(fn: (r) => r._measurement == \"weather_raw\" and r._field == \"wind_kmh\") |> last()"
        }
