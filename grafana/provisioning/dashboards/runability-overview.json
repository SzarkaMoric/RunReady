              "temp_max_c": 1,
              "temp_min_c": 2,
              "precip_sum_mm": 3,
              "wind_max_kmh": 4
            },
            "renameByName": {
              "day": "Day",
              "temp_max_c": "Max. temperature",
              "temp_min_c": "Min. temperature",
              "precip_sum_mm": "Rain forecast",
              "wind_max_kmh": "Wind (km/h)"
