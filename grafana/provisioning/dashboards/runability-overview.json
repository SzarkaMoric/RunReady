          "refId": "A",
          "query": "import \"strings\"\nfrom(bucket: \"runability\") |> range(start: -12h, stop: 8d) |> filter(fn: (r) => r.location_id == \"${location_id}\") |> filter(fn: (r) => r._measurement == \"weather_forecast_daily\") |> filter(fn: (r) => contains(value: r._field, set: [\"temp_min_c\", \"temp_max_c\", \"precip_sum_mm\", \"wind_max_kmh\"])) |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> sort(columns: [\"_time\"]) |> map(fn: (r) => ({ r with day: strings.substring(v: string(v: r._time), start: 0, end: 10) })) |> keep(columns: [\"day\", \"temp_max_c\", \"temp_min_c\", \"precip_sum_mm\", \"wind_max_kmh\"])"
        }
      ],
      "options": {
        "showHeader": true
      },
      "transformations": [
