        {
          "refId": "A",
          "query": "from(bucket: \"runability\") |> range(start: -7d) |> filter(fn: (r) => r.location_id == \"${location_id}\") |> filter(fn: (r) => r._measurement == \"air_quality_raw\" and r._field == \"aqi\") |> last()"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
